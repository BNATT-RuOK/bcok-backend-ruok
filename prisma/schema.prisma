generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CHECKIN {
  checkin_id     Int       @id @default(autoincrement())
  user_id        Int?
  scheduled_time DateTime? @db.Timestamptz(6)
  actual_time    DateTime? @db.Timestamptz(6)
  status         String?   @db.VarChar
  USER           USER?     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CONTACT {
  user_id       Int
  contact_phone String         @db.VarChar
  email         String?        @db.VarChar
  contact_name  String?        @db.VarChar
  relationship  String?        @db.VarChar
  expo_push_token   String?    @db.VarChar
  USER          USER           @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  NOTIFICATION  NOTIFICATION[]

  @@id([user_id, contact_phone])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model NOTIFICATION {
  notification_id   Int        @id @default(autoincrement())
  sos_id            Int?
  user_id           Int?
  contact_phone     String?    @db.VarChar
  notification_type String?    @db.VarChar
  sent_at           DateTime?  @default(now()) @db.Timestamptz(6)
  status            String?    @db.VarChar
  SOS_ALERT         SOS_ALERT? @relation(fields: [sos_id], references: [sos_id], onDelete: NoAction, onUpdate: NoAction)
  CONTACT           CONTACT?   @relation(fields: [user_id, contact_phone], references: [user_id, contact_phone], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model SOS_ALERT {
  sos_id       Int            @id @default(autoincrement())
  user_id      Int?
  trigger_type String?        @db.VarChar
  triggered_at DateTime?      @default(now()) @db.Timestamptz(6)
  latitude     Decimal?       @db.Decimal
  longitude    Decimal?       @db.Decimal
  photo_url    String?        @db.VarChar
  audio_url    String?        @db.VarChar
  status       String?        @db.VarChar
  NOTIFICATION NOTIFICATION[]
  USER         USER?          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model USER {
  user_id               Int         @id @default(autoincrement())
  email                 String?     @db.VarChar
  password_hash         String?     @db.VarChar
  google_id             String?     @db.VarChar
  full_name             String?     @db.VarChar
  phone_number          String?     @db.VarChar
  checkin_interval_mins Int?
  sos_timeout_mins      Int?
  created_at            DateTime?   @default(now()) @db.Timestamptz(6)
  CHECKIN               CHECKIN[]
  CONTACT               CONTACT[]
  SOS_ALERT             SOS_ALERT[]
}
